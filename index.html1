<!DOCTYPE html>
<html lang="en" oncontextmenu="return false;">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Starhela Agencies Global Portals</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        * { -webkit-user-select: none; user-select: none; box-sizing: border-box; }
        body { background-color: #f4f7f6; color: #2c3e50; font-family: 'Inter', system-ui, -apple-system, sans-serif; line-height: 1.7; padding: 20px; }
        .container-slim { max-width: 850px; margin: 0 auto; background: #fff; padding: 40px; border-radius: 20px; box-shadow: 0 4px 25px rgba(0,0,0,0.05); }
        
        h2 { color: #111; font-weight: 900; margin-top: 45px; margin-bottom: 20px; font-size: 1.5rem; text-transform: uppercase; letter-spacing: -0.5px; }
        p { margin-bottom: 25px; font-size: 1.05rem; color: #4a5568; }

        /* MULTI-COUNTRY BUTTON GRID */
        .country-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 15px; margin: 30px 0;
        }
        .country-card {
            background: #1a202c; color: #fff; padding: 25px; border-radius: 15px;
            display: flex; flex-direction: column; gap: 10px; border: 1px solid #2d3748;
        }
        .country-card h3 { font-size: 1.1rem; color: #ffcc00; font-weight: 800; margin-bottom: 10px; border-bottom: 1px solid #4a5568; padding-bottom: 10px; }
        
        .action-link {
            padding: 14px; border-radius: 8px; text-decoration: none !important; text-align: center; 
            font-weight: 800; font-size: 0.8rem; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex; align-items: center; justify-content: center; gap: 10px;
            text-transform: uppercase;
        }
        .btn-gold { background: #ffcc00; color: #000; }
        .btn-outline { background: transparent; color: #fff; border: 1px solid #4a5568; }
        .btn-wa { background: #25d366; color: #fff; }
        
        .action-link:hover { transform: scale(1.03); filter: brightness(1.1); }

        /* LIVE STATUS NOTIFICATION */
        #status-bar {
            position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
            background: #2d3748; color: #fff; padding: 12px 25px; border-radius: 50px;
            font-size: 0.85rem; z-index: 1000; display: none; box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        }
    </style>
</head>
<body>

<div class="container-slim">

