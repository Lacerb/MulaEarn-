        </div>
    </div>

</div>

<div id="status-bar">
    <i class="fas fa-circle-notch fa-spin" style="color: #ffcc00;"></i> <span id="status-text"></span>
</div>

<script>
    const events = [
        "Uganda: Phiona just withdrew UGX 35,000",
        "Kenya: Otieno received KSH 1,500 via M-Pesa",
        "Tanzania: Hassan withdrew TSH 22,000 successfully",
        "Nigeria: Emeka just earned NGN 5,000 referral bonus",
        "System: Automated payouts currently active"
    ];

    function updateStatus() {
        const bar = document.getElementById('status-bar');
        const txt = document.getElementById('status-text');
        const rand = events[Math.floor(Math.random() * events.length)];
        
        txt.innerText = rand;
        bar.style.display = 'block';
        
        setTimeout(() => { bar.style.display = 'none'; }, 6000);
    }

    setInterval(updateStatus, 15000);
    setTimeout(updateStatus, 3000);

    document.addEventListener('contextmenu', e => e.preventDefault());
</script>

</body>
</html>

